# PostgreSQL / Supabase
# Transaction Pooler (execution): puerto 6543 + pgBouncer.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[REGION-POOLER-HOST]:6543/postgres?pgbouncer=true&sslmode=require"
# Session Pooler (db push / db seed / migraciones): puerto 5432.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[REGION-POOLER-HOST]:5432/postgres?sslmode=require"

# Session JWT: genera al menos 32 bytes aleatorios.
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-bytes"

# Twilio credentials
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-your-twilio-auth-token"
TWILIO_API_KEY_SID="SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_API_KEY_SECRET="replace-with-your-twilio-api-key-secret"
TWILIO_TWIML_APP_SID="APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+15551234567"

# Public HTTPS URL used by voice/SMS webhooks.
APP_URL="https://your-public-domain.example"
# Temporary backward-compatible fallback. Prefer APP_URL.
NEXT_PUBLIC_APP_URL=""

# Comma-separated origins allowed to embed /widget (no wildcards).
# Production fallback is 'self' only; development also allows localhost origins.
# Example: https://client.example.com,https://portal.example.com
WIDGET_ALLOWED_ORIGINS="https://partner.example.com,https://app.example.com"

# Calling and registration safety controls
ALLOWED_CALL_PREFIXES="+1,+57"
MAX_OUTBOUND_CALLS_PER_DAY="30"
REGISTRATION_INVITE_CODE="replace-with-a-private-invite-code"

# Obligatoria para db:seed: elige una contraseña propia de 12 a 72 bytes; el seed se niega a correr sin ella.
DEMO_USER_PASSWORD=""

# Voice voicemail preparation; keep disabled until full recording callbacks are implemented.
TWILIO_VOICEMAIL_ENABLED="false"
