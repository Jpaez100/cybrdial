# PostgreSQL
# Copy the pooler host and username from Supabase Dashboard > Connect; URL-encode the database password.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-bytes"

# Twilio account and API credentials
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_API_KEY_SID="SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_API_KEY_SECRET="your-twilio-api-key-secret"
TWILIO_TWIML_APP_SID="APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+15551234567"

# Public URL used when configuring Twilio webhooks
APP_URL="http://localhost:3000"

# Calling safety controls
ALLOWED_CALL_PREFIXES="+1,+57"
MAX_OUTBOUND_CALLS_PER_DAY="30"
REGISTRATION_INVITE_CODE="replace-with-a-private-invite-code"

# Optional demo account seed; set a unique password before running npm run db:seed
DEMO_USER_PASSWORD=""
